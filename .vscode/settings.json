{
  "npm.scriptRunner": "vp",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.fmt.configPath": "./vite.config.ts",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "workbench.colorCustomizations": {
    "statusBar.background": "#1D63ED",
    "statusBar.noFolderBackground": "#1D63ED",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderForeground": "#ffffff",
    "titleBar.activeBackground": "#1D63ED",
    "titleBar.inactiveBackground": "#1D63ED",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveForeground": "#ffffffB3",
    "activityBar.background": "#1D63ED",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#ffffffB3"
  }
}
